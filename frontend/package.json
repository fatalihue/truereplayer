{
  "name": "frontend",
  "private": true,
  "version": "2.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:hooks && tsc -b && vite build",
    "lint": "eslint .",
    "lint:hooks": "eslint -c eslint.hooks.config.js --suppressions-location eslint-hooks-suppressions.json .",
    "lint:hooks:prune": "eslint -c eslint.hooks.config.js --suppressions-location eslint-hooks-suppressions.json --prune-suppressions .",
    "lint:hooks:accept": "eslint -c eslint.hooks.config.js --suppressions-location eslint-hooks-suppressions.json --suppress-all .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/html": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "emoji-picker-react": "^4.18.0",
    "lexical": "^0.44.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
